---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  ogType?: string;
}

const {
  title,
  description,
  ogImage = "/images/default-og.png",
  canonicalURL,
  ogType = "website",
} = Astro.props;

const siteURL = Astro.site?.origin ?? "https://prayashmishra.com";
const fullTitle = `${title} | Prayash Mishra`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d8276" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    {
      canonicalURL ? (
        <link rel="canonical" href={canonicalURL} />
      ) : (
        <link rel="canonical" href={new URL(Astro.url.pathname, siteURL).href} />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL ?? new URL(Astro.url.pathname, siteURL).href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteURL).href} />
    <meta property="og:site_name" content="Prayash Mishra" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL ?? new URL(Astro.url.pathname, siteURL).href} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteURL).href} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Prayash Mishra Blog"
      href="/rss.xml"
    />

    <!-- Dark mode script (inline to prevent flash) -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        if (
          stored === "dark" ||
          (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col font-sans bg-[#fbf9f5] dark:bg-[#0c0d0e] text-[#221f1d] dark:text-[#f2f4f6] relative selection:bg-brand-500/20 selection:text-brand-700 dark:selection:text-brand-300">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 bg-grid-pattern opacity-100 pointer-events-none z-0"></div>
    <div class="ambient-glow"></div>

    <header
      class="sticky top-0 z-50 bg-[#fbf9f5]/85 dark:bg-[#0c0d0e]/80 backdrop-blur-md border-b border-[#e8e2d5]/80 dark:border-zinc-800/80 transition-all duration-200"
    >
      <div
        class="mx-auto max-w-5xl flex items-center justify-between px-6 py-4"
      >
        <a
          href="/"
          class="flex items-center gap-2 group focus:outline-none"
        >
          <span class="h-7 w-7 rounded-lg bg-brand-700 dark:bg-brand-600 flex items-center justify-center text-white font-mono font-bold text-xs shadow-sm">
            PM
          </span>
          <span class="text-sm sm:text-base font-bold tracking-tight text-[#1c1915] dark:text-zinc-100 group-hover:text-brand-700 dark:group-hover:text-brand-400 transition-colors">
            Prayash Mishra
          </span>
        </a>

        <nav class="flex items-center gap-3 sm:gap-4" aria-label="Main navigation">
          <a
            href="/"
            class="text-sm font-medium text-[#5c5344] dark:text-zinc-400 hover:text-[#1c1915] dark:hover:text-zinc-100 transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:h-[2px] after:w-0 hover:after:w-full after:bg-brand-600 after:transition-all"
          >
            Home
          </a>
          <a
            href="/blog"
            class="text-sm font-medium text-[#5c5344] dark:text-zinc-400 hover:text-[#1c1915] dark:hover:text-zinc-100 transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:h-[2px] after:w-0 hover:after:w-full after:bg-brand-600 after:transition-all"
          >
            Publications
          </a>

          <div class="h-4 w-[1px] bg-[#d5ccba] dark:bg-zinc-800 mx-1"></div>

          <!-- GitHub Link -->
          <a
            href="https://github.com/mishraprayash"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Profile"
            class="p-1.5 rounded-xl text-[#5c5344] dark:text-zinc-400 hover:text-[#1c1915] dark:hover:text-zinc-100 hover:bg-[#f4eee3] dark:hover:bg-zinc-800/60 transition-all cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>

          <!-- LinkedIn Link -->
          <a
            href="https://www.linkedin.com/in/prayash-mishra-5a409422b/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn Profile"
            class="p-1.5 rounded-xl text-[#5c5344] dark:text-zinc-400 hover:text-[#0077b5] dark:hover:text-[#38bdf8] hover:bg-[#f4eee3] dark:hover:bg-zinc-800/60 transition-all cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>

          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="p-1.5 rounded-xl text-[#5c5344] dark:text-zinc-400 hover:bg-[#f4eee3] dark:hover:bg-zinc-800/60 transition-all cursor-pointer"
          >
            <span class="sr-only">Toggle dark mode</span>
            <!-- Sun icon -->
            <svg
              id="sun-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hidden dark:block"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon icon -->
            <svg
              id="moon-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="block dark:hidden"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="flex-1 relative z-10">
      <slot />
    </main>

    <footer
      class="border-t border-[#e8e2d5]/80 dark:border-zinc-800/80 bg-[#f5f0e6]/50 dark:bg-[#0c0d0e]/50 relative z-10"
    >
      <div
        class="mx-auto max-w-5xl px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-[#7d7260] dark:text-zinc-500"
      >
        <p>&copy; {new Date().getFullYear()} Prayash Mishra. Distributed Systems & AI Engineering.</p>
        <div class="flex items-center gap-4">
          <a href="/rss.xml" class="hover:text-[#1c1915] dark:hover:text-zinc-300 transition-colors">RSS</a>
          <a href="/blog" class="hover:text-[#1c1915] dark:hover:text-zinc-300 transition-colors">Publications</a>
          <a href="https://github.com/mishraprayash" target="_blank" rel="noopener noreferrer" class="hover:text-[#1c1915] dark:hover:text-zinc-300 transition-colors">GitHub</a>
          <a href="https://www.linkedin.com/in/prayash-mishra-5a409422b/" target="_blank" rel="noopener noreferrer" class="hover:text-[#1c1915] dark:hover:text-zinc-300 transition-colors">LinkedIn</a>
        </div>
      </div>
    </footer>

    <!-- Theme toggle script -->
    <script>
      const toggle = document.getElementById("theme-toggle");
      if (toggle) {
        toggle.addEventListener("click", () => {
          const isDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        });
      }
    </script>
  </body>
</html>
