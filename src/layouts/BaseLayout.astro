---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import displayLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import serifLatin from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { SITE, socialImage, canonicalFor } from "../lib/seo";
import { getPosts } from "../lib/posts";
import type { PillarId } from "../data/taxonomy";

export interface Props {
  title: string;
  description?: string;
  /** Full <title> for pages that should not get the "| Site" suffix. */
  titleOverride?: string;
  ogImage?: string;
  canonicalURL?: string;
  ogType?: string;
  /** Colours the page (reading progress, accents) in this pillar's colour. */
  pillar?: PillarId;
  /** Show the reading-progress line under the header (posts). */
  progress?: boolean;
}

const {
  title,
  description = SITE.description,
  titleOverride,
  ogImage,
  canonicalURL,
  ogType = "website",
  pillar,
  progress = false,
} = Astro.props;

// The "issue line" in the header: month of the newest post and the post count.
const posts = await getPosts();
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const newest = posts[0]?.data.publishDate;
const issue = newest ? `${MONTHS[newest.getUTCMonth()]} ${newest.getUTCFullYear()} · ${posts.length} posts` : "";

const site = Astro.site ?? new URL(SITE.url);
const fullTitle = titleOverride ?? (title === SITE.name ? SITE.name : `${title} | ${SITE.name}`);
const canonical = canonicalURL ?? canonicalFor(Astro.url.pathname, site);
const socialCard = socialImage(ogImage, site);

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/blog", label: "Writing" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en" class="no-js" data-theme="light" data-theme-pref="system" data-motion="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#1b1814" />

    <!-- Theme and motion, set before first paint. "theme" in localStorage is
         "light", "dark", or absent (follow the system); "motion" is "on",
         "off", or absent (follow prefers-reduced-motion). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var pref = "system", motion = null;
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") pref = stored;
          motion = localStorage.getItem("motion");
        } catch (e) {}
        var dark = pref === "dark" || (pref === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
        if (motion !== "on" && motion !== "off") motion = matchMedia("(prefers-reduced-motion: reduce)").matches ? "off" : "on";
        root.classList.remove("no-js");
        root.classList.add("js");
        root.dataset.themePref = pref;
        root.dataset.theme = dark ? "dark" : "light";
        root.dataset.motion = motion;
      })();
    </script>

    <link rel="preload" href={displayLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialCard.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialCard.href} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}`} href="/rss.xml" />

    <slot name="head" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${SITE.url}/#website`,
          url: SITE.url,
          name: SITE.name,
          description: SITE.description,
          inLanguage: "en-US",
        },
        {
          "@type": "Person",
          "@id": `${SITE.url}/#person`,
          name: SITE.name,
          url: SITE.url,
          jobTitle: SITE.tagline,
          description: SITE.description,
          sameAs: [
            "https://github.com/mishraprayash",
            "https://www.linkedin.com/in/prayash-mishra-5a409422b/",
          ],
        },
      ],
    })} />
  </head>

  <body class:list={[pillar && `pillar-${pillar}`]}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="bar">
      <div class="bar__in">
        <a class="bar__logo" href="/">PRAYASH<span>/</span>MISHRA</a>
        <span class="bar__issue">Backend notes · how systems fail at the seams · {issue}</span>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="bar__tools">
          <a class="icon-btn" href="/rss.xml" aria-label="RSS feed">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          </a>
          <button class="icon-btn motion-toggle" type="button" id="motion-toggle" aria-pressed="true" aria-label="Animations">
            <svg data-icon="on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>
            <svg data-icon="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4l12 8-12 8z"/></svg>
          </button>
          <button class="icon-btn theme-toggle" type="button" id="theme-toggle" aria-label="Theme: follow system">
            <svg data-icon="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
            <svg data-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <svg data-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </div>
      </div>
      {progress && <div class="bar__progress" id="progress" aria-hidden="true"></div>}
    </header>

    <slot name="above" />

    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="foot">
      <p class="foot__big">Read the <span>failure</span>, keep the fix.</p>
      <div class="foot__row">
        <span>&copy; {new Date().getFullYear()} Prayash Mishra</span>
        <ul>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="https://github.com/mishraprayash">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/prayash-mishra-5a409422b/">LinkedIn</a></li>
          <li><a href="https://github.com/mishraprayash/PrayashBlog">Source</a></li>
        </ul>
      </div>
    </footer>

    <script>
      const ORDER = ["system", "light", "dark"] as const;
      type Pref = (typeof ORDER)[number];
      const LABEL: Record<Pref, string> = {
        system: "Theme: follow system",
        light: "Theme: light",
        dark: "Theme: dark",
      };
      const root = document.documentElement;
      const scheme = matchMedia("(prefers-color-scheme: dark)");
      const themeBtn = document.getElementById("theme-toggle");
      const motionBtn = document.getElementById("motion-toggle");

      function applyTheme(pref: Pref) {
        const dark = pref === "dark" || (pref === "system" && scheme.matches);
        root.dataset.themePref = pref;
        root.dataset.theme = dark ? "dark" : "light";
        themeBtn?.setAttribute("aria-label", LABEL[pref]);
      }
      applyTheme((root.dataset.themePref as Pref) ?? "system");
      themeBtn?.addEventListener("click", () => {
        const current = (root.dataset.themePref as Pref) ?? "system";
        const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
        try {
          if (next === "system") localStorage.removeItem("theme");
          else localStorage.setItem("theme", next);
        } catch {}
        applyTheme(next);
      });
      scheme.addEventListener("change", () => {
        if (root.dataset.themePref === "system") applyTheme("system");
      });

      // Animated SVGs (covers, diagrams) run only while on screen and while
      // motion is on. CSS animation is paused by [data-motion="off"].
      const motionOn = () => root.dataset.motion === "on";
      const visible = new Set<SVGSVGElement>();
      const syncSvg = (svg: SVGSVGElement) => {
        if (motionOn() && visible.has(svg)) svg.unpauseAnimations();
        else svg.pauseAnimations();
      };
      const svgIO = new IntersectionObserver((entries) => {
        for (const e of entries) {
          const svg = e.target as SVGSVGElement;
          if (e.isIntersecting) visible.add(svg);
          else visible.delete(svg);
          syncSvg(svg);
        }
      });
      for (const svg of document.querySelectorAll<SVGSVGElement>("svg[data-anim]")) {
        svg.pauseAnimations();
        svgIO.observe(svg);
      }
      function applyMotion(on: boolean) {
        root.dataset.motion = on ? "on" : "off";
        motionBtn?.setAttribute("aria-pressed", String(on));
        motionBtn?.setAttribute("aria-label", on ? "Animations on" : "Animations off");
        document.querySelectorAll<SVGSVGElement>("svg[data-anim]").forEach(syncSvg);
      }
      applyMotion(motionOn());
      motionBtn?.addEventListener("click", () => {
        const next = !motionOn();
        try {
          localStorage.setItem("motion", next ? "on" : "off");
        } catch {}
        applyMotion(next);
      });

      // Reveal blocks as they scroll in.
      const revealIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add("in");
            revealIO.unobserve(e.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".rv").forEach((el) => revealIO.observe(el));

      // Reading progress (posts only).
      const bar = document.getElementById("progress");
      const body = document.getElementById("post-body");
      if (bar && body) {
        let queued = false;
        const update = () => {
          queued = false;
          const r = body.getBoundingClientRect();
          const done = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
          bar.style.transform = `scaleX(${done})`;
        };
        addEventListener("scroll", () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(update);
          }
        }, { passive: true });
        update();
      }
    </script>
  </body>
</html>
