---
import { headline, postUrl, type Post, type SeriesInfo } from "../../lib/posts";

export interface Props {
  series: SeriesInfo;
  current: Post;
}

const { series, current } = Astro.props;
const index = series.parts.findIndex((p) => p.id === current.id);
const next = series.parts[index + 1];
---

<nav class="series-nav" aria-label={`Series: ${series.title}`}>
  <p class="series-nav__label">
    Part {index + 1} of {series.parts.length} in <a href={`/series/${series.id}`}>{series.title}</a>
  </p>
  <ol class="series-nav__list">
    {series.parts.map((p) => (
      <li>
        {p.id === current.id ? (
          <span aria-current="page">{headline(p)} <span class="series-nav__here">(you're here)</span></span>
        ) : (
          <a href={postUrl(p)}>{headline(p)}</a>
        )}
      </li>
    ))}
  </ol>
  {next ? (
    <p class="series-nav__next">
      <a href={postUrl(next)}>Next: {headline(next)} →</a>
    </p>
  ) : (
    <p class="series-nav__end">
      That's the end of the series. <a href={postUrl(series.parts[0])}>Start from part 1</a>, or <a href="/series">see all series</a>.
    </p>
  )}
</nav>

<style>
  .series-nav {
    border: var(--rule-w) solid var(--line);
    background: var(--paper-2);
    box-shadow: 8px 8px 0 var(--c);
  }
  .series-nav__label {
    margin: 0;
    padding: 12px 16px;
    background: #111111;
    color: #f1eee6;
    font: 600 0.75rem / 1.4 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .series-nav__label a { color: #f1eee6; text-decoration: underline; text-underline-offset: 0.2em; }
  .series-nav__label a:focus-visible { outline-color: #f1eee6; }
  .series-nav__list {
    margin: 0;
    padding: 8px 16px 8px 3em;
    font: 600 1.0625rem / 1.35 var(--display);
  }
  .series-nav__list li { padding: 6px 0; }
  .series-nav__list li::marker { font: 600 0.8125rem / 1 var(--mono); color: var(--muted); }
  .series-nav__list a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .series-nav__list a:hover { text-decoration-thickness: 3px; }
  [aria-current="page"] { color: var(--c-text); }
  .series-nav__here { font: 500 0.75rem / 1 var(--mono); text-transform: uppercase; color: var(--muted); }
  .series-nav__next, .series-nav__end {
    margin: 0;
    padding: 14px 16px;
    border-top: 1px solid var(--line);
    font: 500 1rem / 1.4 var(--serif);
  }
  .series-nav__next a { font: 800 1.125rem / 1.3 var(--display); text-decoration: underline; text-underline-offset: 0.2em; }
</style>
