---
export interface Props {
  url: string;
}
const { url } = Astro.props;
---

<p class="copy-link">
  <button type="button" class="btn copy-link__btn" data-copy-link={url}>Copy link</button>
  <span class="copy-link__status" role="status" aria-live="polite"></span>
</p>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy-link]")) {
    const status = btn.nextElementSibling as HTMLElement | null;
    btn.addEventListener("click", async () => {
      const url = btn.dataset.copyLink || location.href;
      try {
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = "Copied";
      } catch {
        // No clipboard access (e.g. an insecure context): show the URL so it
        // can be copied by hand.
        if (status) status.textContent = url;
      }
      setTimeout(() => status && (status.textContent = ""), 3000);
    });
  }
</script>

<style>
  .copy-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0;
  }
  .copy-link__status { font: 500 0.8125rem / 1.4 var(--mono); color: var(--muted); overflow-wrap: anywhere; }
  .no-js .copy-link { display: none; }
</style>
