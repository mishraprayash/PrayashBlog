---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const items = Astro.props.headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  // The heading anchor plugin appends a "#" link to each heading.
  .map((h) => ({ ...h, text: h.text.replace(/\s*#$/, "").replace(/^\d+\.\s+/, "") }));
const sections = items.filter((h) => h.depth === 2).length;
const show = sections >= 4;
---

{show && (
  <>
    <nav class="toc toc--rail" aria-label="Contents">
      <p class="toc__label">Contents</p>
      <ol class="toc__list">
        {items.map((h) => (
          <li class={h.depth === 3 ? "toc__sub" : undefined}>
            <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>

    <details class="toc toc--inline">
      <summary>Contents ({sections} sections)</summary>
      <ol class="toc__list">
        {items.filter((h) => h.depth === 2).map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </details>
  </>
)}

<script>
  // Marks the section currently being read in the side ToC.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")].map((a) => [a.dataset.tocLink!, a]),
  );
  if (links.size) {
    let current: HTMLAnchorElement | undefined;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const link = links.get(entry.target.id);
          if (!link || link === current) continue;
          current?.removeAttribute("aria-current");
          link.setAttribute("aria-current", "location");
          current = link;
        }
      },
      { rootMargin: "-72px 0px -70% 0px" },
    );
    for (const id of links.keys()) {
      const heading = document.getElementById(id);
      if (heading) observer.observe(heading);
    }
  }
</script>

<style>
  .toc { font: 500 0.8125rem / 1.4 var(--mono); }
  .toc__label {
    margin: 0 0 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  .toc__list { list-style: none; margin: 0; padding: 0; }
  .toc a {
    display: block;
    padding: 5px 0 5px 12px;
    border-left: 3px solid var(--soft-line);
    color: var(--muted);
    text-decoration: none;
  }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { color: var(--ink); border-left-color: var(--c); }
  .toc__sub a { padding-left: 28px; }

  .toc--rail { display: none; }
  .toc--inline { margin: 0 0 30px; border: 1.5px solid var(--line); }
  .toc--inline summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .toc--inline .toc__list { padding: 0 14px 12px; }

  @media (min-width: 1280px) {
    .toc--rail {
      display: block;
      position: sticky;
      top: calc(var(--bar-h) + 32px);
      max-height: calc(100vh - var(--bar-h) - 64px);
      overflow-y: auto;
    }
    .toc--inline { display: none; }
  }
</style>
