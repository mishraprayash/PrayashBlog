---
export interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);
---

<div class="my-8 py-6 border-y border-[#e8e2d5] dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
  <span class="text-xs font-semibold uppercase tracking-wider text-[#7d7260] dark:text-zinc-400">
    Share this publication
  </span>
  <div class="flex items-center gap-2">
    <!-- Copy Link Button -->
    <button
      id="copy-link-btn"
      data-url={url}
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#e8e2d5] dark:border-zinc-800 bg-[#ffffff] dark:bg-zinc-900 text-xs font-medium text-[#453e33] dark:text-zinc-300 hover:border-brand-600 transition-all cursor-pointer shadow-sm shadow-[#ece5d8]/40 dark:shadow-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="copy-icon">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <span id="copy-btn-text">Copy Link</span>
    </button>

    <!-- X / Twitter -->
    <a
      href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      class="p-2 rounded-lg border border-[#e8e2d5] dark:border-zinc-800 bg-[#ffffff] dark:bg-zinc-900 text-[#453e33] dark:text-zinc-300 hover:text-brand-600 hover:border-brand-600 transition-all shadow-sm shadow-[#ece5d8]/40 dark:shadow-none"
      aria-label="Share on X"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
    </a>

    <!-- LinkedIn -->
    <a
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      class="p-2 rounded-lg border border-[#e8e2d5] dark:border-zinc-800 bg-[#ffffff] dark:bg-zinc-900 text-[#453e33] dark:text-zinc-300 hover:text-brand-600 hover:border-brand-600 transition-all shadow-sm shadow-[#ece5d8]/40 dark:shadow-none"
      aria-label="Share on LinkedIn"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
      </svg>
    </a>
  </div>
</div>

<script is:inline>
  const copyBtn = document.getElementById("copy-link-btn");
  const copyText = document.getElementById("copy-btn-text");

  if (copyBtn && copyText) {
    copyBtn.addEventListener("click", async () => {
      const url = copyBtn.getAttribute("data-url") || window.location.href;
      await navigator.clipboard.writeText(url);
      copyText.textContent = "Copied!";
      copyBtn.classList.add("border-brand-600", "text-brand-700", "dark:text-brand-300");

      setTimeout(() => {
        copyText.textContent = "Copy Link";
        copyBtn.classList.remove("border-brand-600", "text-brand-700", "dark:text-brand-300");
      }, 2000);
    });
  }
</script>
