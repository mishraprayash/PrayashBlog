---
import { PILLARS } from "../data/taxonomy";
import { formatDate, formatShortDate, postUrl, readingTime, type Post } from "../lib/posts";

export interface Props {
  posts: Post[];
  /** Show the year in the date (off when the list is already grouped by year). */
  showYear?: boolean;
  showPillar?: boolean;
  /** Show "Part n of m" after the title for series posts. */
  seriesTotals?: Map<string, number>;
  /** Optional one-line note per post slug, shown under the title. */
  notes?: Record<string, string>;
}

const { posts, showYear = true, showPillar = true, seriesTotals, notes } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => {
    const total = post.data.series ? seriesTotals?.get(post.data.series) : undefined;
    const revised = post.data.updatedDate;
    return (
      <li class="post-row">
        <time class="post-row__date" datetime={post.data.publishDate.toISOString()}>
          {showYear ? formatDate(post.data.publishDate) : formatShortDate(post.data.publishDate)}
        </time>
        <div class="post-row__main">
          <a class="post-row__title" href={postUrl(post)}>{post.data.title}</a>
          {notes?.[post.id] && <p class="post-row__note">{notes[post.id]}</p>}
          <p class="post-row__meta">
            {showPillar && <span>{PILLARS[post.data.pillar].short}</span>}
            {total && <span>Part {post.data.seriesPart} of {total}</span>}
            <span>{readingTime(post.body)} min</span>
            {revised && <span>revised</span>}
          </p>
        </div>
      </li>
    );
  })}
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px var(--space-5);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--rule);
  }
  .post-row:last-child { border-bottom: 1px solid var(--rule); }
  @media (min-width: 640px) {
    .post-row { grid-template-columns: 7rem 1fr; align-items: baseline; }
  }
  .post-row__date {
    font: 400 var(--text-small) / 1.6 var(--font-ui);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .post-row__title {
    font: 600 1.1875rem / 1.35 var(--font-serif);
    color: var(--ink);
    text-decoration: none;
  }
  .post-row__title:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .post-row__note {
    margin: 4px 0 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .post-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: 4px 0 0;
    font: 400 var(--text-small) / 1.5 var(--font-ui);
    color: var(--muted);
  }
  .post-row__meta span + span::before {
    content: "·";
    margin-right: var(--space-3);
  }
</style>
