---
import { PILLARS } from "../data/taxonomy";
import { formatDate, headline, postUrl, readingTime, type Post } from "../lib/posts";

export interface Props {
  posts: Post[];
  /** Series parts: show reading time instead of the date. */
  numbered?: boolean;
  showPillar?: boolean;
  showDescription?: boolean;
}
const { posts, numbered = false, showPillar = true, showDescription = false } = Astro.props;
---

<ol class="rows">
  {posts.map((post, i) => (
    <li>
      <a class="row" href={postUrl(post)}>
        <span class="row__n">{String(i + 1).padStart(2, "0")}</span>
        <span>
          <span class="row__t">{headline(post)}</span>
          {showDescription && <span class="row__d">{post.data.description}</span>}
        </span>
        <span class="row__m">
          {showPillar && <>{PILLARS[post.data.pillar].short} · </>}
          {numbered ? `${readingTime(post.body)} min` : formatDate(post.data.publishDate)}
        </span>
      </a>
    </li>
  ))}
</ol>
