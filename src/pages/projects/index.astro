---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import TodoText from "../../components/TodoText.astro";

const projects = (await getCollection("projects", ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Projects" description="The systems behind the writing: what each was for, how it was built, and what part was mine.">
  <PageHead title="Projects">
    <p class="phead__lede">Backend work is mostly invisible, so each of these says what the system was for, how it fits together, what I did, and which posts came out of it.</p>
  </PageHead>
  <section class="strip" aria-label="Projects">
    <ul class="tiles">
      {projects.map((p, i) => (
        <li>
          <div class="tile">
            <span class="label">{String(i + 1).padStart(2, "0")} · <TodoText text={p.data.status} /></span>
            <h2 class="tile__h"><a href={`/projects/${p.id}`}><TodoText text={p.data.title} /></a></h2>
            <p><TodoText text={p.data.summary} /></p>
            <p class="mono" style="font-size:.8125rem;color:#a6a39b"><TodoText text={p.data.role} /> · {p.data.stack.slice(0, 4).join(", ")}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
