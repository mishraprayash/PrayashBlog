---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import CardGrid from "../../components/CardGrid.astro";
import TodoText from "../../components/TodoText.astro";
import { getPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => import.meta.env.DEV || !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { data } = project;
const { Content } = await render(project);
const posts = await getPosts();
const missing = data.posts.filter((slug) => !posts.some((p) => p.id === slug));
if (missing.length) throw new Error(`Project "${project.id}" lists posts that don't exist: ${missing.join(", ")}`);
const written = data.posts.map((slug) => posts.find((p) => p.id === slug)!);
const plainTitle = data.title.replace(/\[TODO:[^\]]*\]/g, "Project").trim();
---

<BaseLayout title={plainTitle} description={data.summary.replace(/\s*\[TODO:[^\]]*\]/g, "")}>
  <header class="phead">
    <p class="phead__kicker"><a class="chip" href="/projects">← Projects</a></p>
    <h1 class="phead__title phead__title--md"><TodoText text={data.title} /></h1>
    <p class="phead__lede"><TodoText text={data.summary} /></p>
  </header>
  <dl class="facts">
    <div><dt>Role</dt><dd><TodoText text={data.role} /></dd></div>
    {data.period && <div><dt>When</dt><dd><TodoText text={data.period} /></dd></div>}
    <div><dt>Status</dt><dd><TodoText text={data.status} /></dd></div>
    <div><dt>Stack</dt><dd>{data.stack.join(", ")}</dd></div>
    {data.links.length > 0 && (
      <div><dt>Links</dt><dd>{data.links.map((l, i) => <>{i > 0 && " · "}<a href={l.href}>{l.label}</a></>)}</dd></div>
    )}
  </dl>

  <div class="page-col page-col--center">
    <div class="post-body">
      <Content />
    </div>
  </div>

  {written.length > 0 && (
    <section aria-labelledby="writing">
      <div class="sect-h"><h2 id="writing">Writing from this project</h2></div>
      <CardGrid posts={written} />
    </section>
  )}
</BaseLayout>
