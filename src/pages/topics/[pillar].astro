---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import CardGrid from "../../components/CardGrid.astro";
import { PILLARS, PILLAR_IDS, TAGS, type PillarId } from "../../data/taxonomy";
import { getPosts, getSeries, postsByPillar, postsByTag } from "../../lib/posts";

export function getStaticPaths() {
  return PILLAR_IDS.map((pillar) => ({ params: { pillar } }));
}

const id = Astro.params.pillar as PillarId;
const pillar = PILLARS[id];
const posts = await getPosts();
const inPillar = postsByPillar(posts, id);
const allSeries = getSeries(posts);
const seriesTotals = new Map(allSeries.map((s) => [s.id, s.parts.length]));
const series = allSeries.filter((s) => s.parts.some((p) => p.data.pillar === id));
const tags = TAGS.filter((t) => inPillar.some((p) => p.data.tags.includes(t)));
// A pillar with no posts of its own yet points at the posts that lean on it,
// via the tag of the same name (PostgreSQL today).
const leaning = inPillar.length === 0 && (TAGS as readonly string[]).includes(id) ? postsByTag(posts, id as never) : [];
---

<BaseLayout title={pillar.title} description={`${pillar.title}: ${pillar.description}`} pillar={id}>
  <PageHead
    title={pillar.title}
    pillar={id}
    size="md"
    kicker={[{ href: "/blog", label: "← Writing" }, ...PILLAR_IDS.map((p) => ({ href: `/topics/${p}`, label: PILLARS[p].short, current: p === id }))]}
  >
    <p class="phead__lede">{pillar.description}</p>
    <p class="phead__meta">
      {inPillar.length > 0 ? `${inPillar.length} posts` : "No posts yet"}
      {series.length > 0 && <> · {series.length} series</>}
    </p>
  </PageHead>

  {inPillar.length > 0 ? (
    <CardGrid posts={inPillar} seriesTotals={seriesTotals} heading="h2" label="Posts" />
  ) : (
    <section aria-labelledby="leaning">
      <div class="sect-h"><h2 id="leaning">Nothing here yet</h2></div>
      {leaning.length > 0 && (
        <>
          <p class="page-col">Posts dedicated to this are coming. These are the ones that lean on it most.</p>
          <CardGrid posts={leaning} seriesTotals={seriesTotals} />
        </>
      )}
    </section>
  )}

  {series.length > 0 && (
    <section aria-labelledby="series">
      <div class="sect-h"><h2 id="series">Series</h2></div>
      <ol class="rows">
        {series.map((s, i) => (
          <li>
            <a class="row" href={`/series/${s.id}`}>
              <span class="row__n">{String(i + 1).padStart(2, "0")}</span>
              <span><span class="row__t">{s.title}</span><span class="row__d">{s.description}</span></span>
              <span class="row__m">{s.parts.length} parts</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  {tags.length > 0 && (
    <nav class="phead" aria-label="Tags in this topic">
      <p class="phead__kicker" style="margin:0">{tags.map((t) => <a class="chip" href={`/tags/${t}`}>#{t}</a>)}</p>
    </nav>
  )}
</BaseLayout>
