---
import { render } from "astro:content";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/post/TableOfContents.astro";
import SeriesNav from "../../components/post/SeriesNav.astro";
import CopyLink from "../../components/post/CopyLink.astro";
import PostList from "../../components/PostList.astro";
import { PILLARS } from "../../data/taxonomy";
import { SITE, canonicalFor, socialImage } from "../../lib/seo";
import { formatDate, getPosts, readingTime, relatedPosts, seriesFor, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

const site = Astro.site ?? new URL(SITE.url);
const url = canonicalFor(`/blog/${post.id}`, site);
const pillar = PILLARS[data.pillar];
const series = seriesFor(post, posts);
const partIndex = series ? series.parts.findIndex((p) => p.id === post.id) : -1;
const related = relatedPosts(post, posts);
const minutes = readingTime(post.body);
// A raster featuredImage wins; otherwise the card generated for this post.
const ogImage = data.featuredImage ?? `/og/${post.id}.png`;
const socialCard = socialImage(ogImage, site);
---

<BaseLayout title={data.title} description={data.description} ogImage={ogImage} canonicalURL={url} ogType="article">
  <Fragment slot="head">
    {post.body?.includes("```") && <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />}
    <meta property="article:published_time" content={data.publishDate.toISOString()} />
    {data.updatedDate && <meta property="article:modified_time" content={data.updatedDate.toISOString()} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BlogPosting",
          "@id": `${url}#article`,
          isPartOf: { "@id": `${SITE.url}/#website` },
          headline: data.title,
          description: data.description,
          image: socialCard.href,
          datePublished: data.publishDate.toISOString(),
          dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
          author: { "@id": `${SITE.url}/#person`, "@type": "Person", name: data.author, url: SITE.url },
          publisher: { "@id": `${SITE.url}/#person` },
          mainEntityOfPage: { "@type": "WebPage", "@id": url },
          inLanguage: "en-US",
          articleSection: pillar.title,
          keywords: data.tags.join(", ") || undefined,
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Writing", item: `${SITE.url}/blog` },
            { "@type": "ListItem", position: 2, name: pillar.title, item: `${SITE.url}/topics/${data.pillar}` },
            { "@type": "ListItem", position: 3, name: data.title, item: url },
          ],
        },
      ],
    })} />
  </Fragment>

  <div class="post">
    <header class="post-header">
      <p class="post-kicker">
        <a href={`/topics/${data.pillar}`}>{pillar.title}</a>
        {series && (
          <span>
            Part {partIndex + 1} of {series.parts.length} in <a href={`/series/${series.id}`}>{series.title}</a>
          </span>
        )}
      </p>
      <h1 class="post-title">{data.title}</h1>
      <p class="post-dek">{data.description}</p>
      <div class="post-meta">
        <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
        <span>{minutes} min read</span>
        {data.updatedDate && (
          <details class="post-revised">
            <summary>
              Revised <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time>
            </summary>
            {data.updateSummary && <p>{data.updateSummary}</p>}
          </details>
        )}
        {data.draft && <span class="post-draft">Draft</span>}
      </div>
    </header>

    <aside class="post-toc">
      <TableOfContents headings={headings} />
    </aside>

    <article class="post-body" id="post-body">
      <Content />
    </article>

    <footer class="post-footer">
      {series && <SeriesNav series={series} current={post} />}

      {data.tags.length > 0 && (
        <p class="post-tags">
          <span>Tags:</span>
          {data.tags.map((tag) => <a href={`/tags/${tag}`}>#{tag}</a>)}
        </p>
      )}

      <CopyLink url={url} />

      {related.length > 0 && (
        <section class="post-related" aria-labelledby="related-heading">
          <h2 id="related-heading">Related</h2>
          <PostList posts={related} />
          <p class="post-more"><a href={`/topics/${data.pillar}`}>More on {pillar.title.toLowerCase()} →</a></p>
        </section>
      )}

      <p class="post-follow">
        New posts go out by <a href="/rss.xml">RSS</a>. Written by {data.author}. <a href="https://github.com/mishraprayash">GitHub</a> · <a href="https://www.linkedin.com/in/prayash-mishra-5a409422b/">LinkedIn</a>
      </p>
    </footer>
  </div>
</BaseLayout>

<script>
  // Copy buttons on code blocks (the markup comes from rehypeCodeBlocks).
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".code-block__copy")) {
    btn.addEventListener("click", async () => {
      const pre = btn.closest(".code-block")?.querySelector("pre");
      if (!pre) return;
      const lines = [...pre.querySelectorAll<HTMLElement>(".line")];
      const isDiff = btn.closest<HTMLElement>(".code-block")?.dataset.lang === "diff";
      const code = lines.length
        ? lines.map((l) => (isDiff ? l.textContent!.replace(/^[+-]/, "") : l.textContent)).join("\n")
        : pre.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = "Copied";
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        btn.textContent = "Press Ctrl/⌘ C";
      }
      setTimeout(() => (btn.textContent = "Copy"), 2000);
    });
  }
</script>

<style>
  .post {
    --toc-w: 12rem;
    --notes-w: 12rem;
    --col-gap: 2.5rem;
    max-width: var(--shell);
    margin: 0 auto;
    padding: var(--space-5) var(--gutter) 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "header" "toc" "body" "footer";
  }
  .post-header { grid-area: header; }
  .post-toc { grid-area: toc; }
  .post-body { grid-area: body; }
  .post-footer { grid-area: footer; }
  .post-header,
  .post-body,
  .post-footer { max-width: var(--measure); min-width: 0; }

  @media (min-width: 1024px) {
    .post {
      grid-template-columns: minmax(0, var(--measure)) var(--notes-w);
      column-gap: var(--col-gap);
      grid-template-areas: "header ." "toc ." "body ." "footer .";
      font-size: var(--text-body);
      justify-content: start;
      padding-top: var(--space-6);
    }
  }
  @media (min-width: 1280px) {
    .post {
      grid-template-columns: var(--toc-w) minmax(0, var(--measure)) var(--notes-w);
      grid-template-areas: ". header ." "toc body ." ". footer .";
    }
    .post-toc { align-self: stretch; }
    .post-body { --wide-bleed: calc(var(--col-gap) + var(--notes-w)); }
  }

  /* ---------- header ---------- */
  .post-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: 0 0 var(--space-3);
    font: 400 var(--text-ui) / 1.5 var(--font-ui);
    color: var(--muted);
  }
  .post-kicker > span { flex-basis: 100%; }
  @media (min-width: 640px) {
    .post-kicker > span { flex-basis: auto; }
    .post-kicker > span::before { content: "·"; margin-right: var(--space-3); }
  }
  .post-kicker a { color: var(--ink-2); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .post-kicker a:hover { color: var(--ink); }
  .post-title {
    margin: 0;
    font: 700 var(--text-display) / 1.12 var(--font-serif);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .post-dek {
    margin: var(--space-4) 0 0;
    font: italic 400 var(--text-dek) / 1.45 var(--font-serif);
    color: var(--ink-2);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px var(--space-3);
    margin-top: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
    font: 400 var(--text-ui) / 1.5 var(--font-ui);
    color: var(--muted);
  }
  .post-meta > :is(span, time) + :is(span, time)::before,
  .post-meta > * + .post-revised > summary::before { content: "·"; margin-right: var(--space-3); display: inline-block; text-decoration: none; }
  .post-revised { display: contents; }
  .post-revised summary { cursor: pointer; color: var(--ink-2); text-decoration: underline dotted; text-underline-offset: 0.2em; }
  .post-revised summary::marker { content: ""; }
  .post-revised summary::-webkit-details-marker { display: none; }
  .post-revised > summary { display: inline; }
  @media (max-width: 639px) {
    .post-revised > summary { flex-basis: 100%; }
    .post-meta > * + .post-revised > summary::before { content: none; }
  }
  .post-revised p {
    flex-basis: 100%;
    margin: var(--space-2) 0 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--rule-strong);
    background: var(--raised);
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .post-draft { color: var(--accent); font-weight: 600; }

  .post-body { margin-top: var(--space-5); }
  @media (min-width: 1024px) {
    .post-body { margin-top: var(--space-6); }
  }
  .post-toc :global(.toc--rail) { margin-top: var(--space-6); }

  /* ---------- footer ---------- */
  .post-footer {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-6);
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: 0;
    font: 400 var(--text-ui) / 2 var(--font-ui);
    color: var(--muted);
  }
  .post-tags a { color: var(--ink-2); text-decoration: none; }
  .post-tags a:hover { color: var(--ink); text-decoration: underline; }
  .post-related h2 {
    margin: 0 0 var(--space-3);
    font: 600 var(--text-ui) / 1.4 var(--font-ui);
    color: var(--ink);
  }
  .post-more { margin: var(--space-3) 0 0; font: 400 var(--text-ui) / 1.5 var(--font-ui); }
  .post-follow {
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
    font: 400 var(--text-ui) / 1.6 var(--font-ui);
    color: var(--ink-2);
  }
</style>
