---
import { render } from "astro:content";
import monoLatin from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/post/TableOfContents.astro";
import SeriesNav from "../../components/post/SeriesNav.astro";
import CopyLink from "../../components/post/CopyLink.astro";
import CardGrid from "../../components/CardGrid.astro";
import Cover from "../../components/Cover.astro";
import Rise from "../../components/Rise.astro";
import { PILLARS } from "../../data/taxonomy";
import { SITE, canonicalFor, socialImage } from "../../lib/seo";
import { formatDate, getPosts, headline, postUrl, readingTime, relatedPosts, seriesFor, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

const site = Astro.site ?? new URL(SITE.url);
const url = canonicalFor(`/blog/${post.id}`, site);
const pillar = PILLARS[data.pillar];
const series = seriesFor(post, posts);
const partIndex = series ? series.parts.findIndex((p) => p.id === post.id) : -1;
const related = relatedPosts(post, posts);
const minutes = readingTime(post.body);
// A raster featuredImage wins; otherwise the card generated for this post.
const ogImage = data.featuredImage ?? `/og/${post.id}.png`;
const socialCard = socialImage(ogImage, site);
const seriesTotals = new Map((series ? [[series.id as string, series.parts.length]] : []) as [string, number][]);
// Long titles get a smaller hero size so they still fit the first screen.
const display = headline(post);
const titleSize = display.length <= 34 ? "xl" : display.length <= 64 ? "lg" : "md";
// The longest word also caps the size, so a word like "Idempotency," is never
// broken across lines.
const longestWord = Math.max(...display.split(/\s+/).map((w) => w.length));
// Previous/next: within the series when there is one, otherwise by date.
const chrono = posts.indexOf(post);
const prev = series ? series.parts[partIndex - 1] : posts[chrono + 1];
const next = series ? series.parts[partIndex + 1] : posts[chrono - 1];
---

<BaseLayout title={data.title} description={data.description} ogImage={ogImage} canonicalURL={url} ogType="article" pillar={data.pillar} progress>
  <Fragment slot="head">
    {post.body?.includes("```") && <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />}
    <meta property="article:published_time" content={data.publishDate.toISOString()} />
    {data.updatedDate && <meta property="article:modified_time" content={data.updatedDate.toISOString()} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BlogPosting",
          "@id": `${url}#article`,
          isPartOf: { "@id": `${SITE.url}/#website` },
          headline: data.title,
          description: data.description,
          image: socialCard.href,
          datePublished: data.publishDate.toISOString(),
          dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
          author: { "@id": `${SITE.url}/#person`, "@type": "Person", name: data.author, url: SITE.url },
          publisher: { "@id": `${SITE.url}/#person` },
          mainEntityOfPage: { "@type": "WebPage", "@id": url },
          inLanguage: "en-US",
          articleSection: pillar.title,
          keywords: data.tags.join(", ") || undefined,
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Writing", item: `${SITE.url}/blog` },
            { "@type": "ListItem", position: 2, name: pillar.title, item: `${SITE.url}/topics/${data.pillar}` },
            { "@type": "ListItem", position: 3, name: data.title, item: url },
          ],
        },
      ],
    })} />
  </Fragment>

  <section class="p-hero" aria-labelledby="post-title">
    <div class="p-hero__text">
      <p class="phead__kicker">
        <a class="chip" href={`/topics/${data.pillar}`}>{pillar.short}</a>
        {series && <a class="chip" href={`/series/${series.id}`}>Series · Part {partIndex + 1} / {series.parts.length}</a>}
        {data.tags.map((tag) => <a class="chip" href={`/tags/${tag}`}>#{tag}</a>)}
      </p>
      <Rise text={display} id="post-title" class:list={["p-hero__title", `p-hero__title--${titleSize}`]} style={`--lw:${longestWord}`} />
      <p class="p-hero__dek">{data.description}</p>
      <div class="p-meta">
        <span><b>Published</b><time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time></span>
        {data.updatedDate && (
          <details class="p-meta__revised">
            <summary><b>Revised</b><time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></summary>
            {data.updateSummary && <p>{data.updateSummary}</p>}
          </details>
        )}
        <span><b>Reading</b>{minutes} min</span>
        <span><b>By</b>{data.author}</span>
        {data.draft && <span><b>Status</b>Draft</span>}
      </div>
    </div>
    <div class="p-hero__art"><Cover cover={data.cover} pillar={data.pillar} /></div>
  </section>

  <div class="article">
    <aside class="article__toc">
      <TableOfContents headings={headings} />
    </aside>

    <article class="post-body" id="post-body">
      <Content />
    </article>

    <footer class="article__end">
      {series && <SeriesNav series={series} current={post} />}
      <div class="article__share">
        <CopyLink url={url} />
        <p>New posts go out by <a href="/rss.xml">RSS</a>. <a href="https://github.com/mishraprayash">GitHub</a> · <a href="https://www.linkedin.com/in/prayash-mishra-5a409422b/">LinkedIn</a></p>
      </div>
    </footer>
  </div>

  {(prev || next) && (
    <nav class="next" aria-label={series ? "Series navigation" : "More posts"}>
      {prev ? (
        <a href={postUrl(prev)}><span class="label">← {series ? `Previous · Part ${partIndex}` : "Older"}</span><span class="t">{headline(prev)}</span></a>
      ) : <span></span>}
      {next && (
        <a href={postUrl(next)} class="next--go"><span class="label">{series ? `Next · Part ${partIndex + 2}` : "Newer"} →</span><span class="t">{headline(next)}</span></a>
      )}
    </nav>
  )}

  {related.length > 0 && (
    <section aria-labelledby="related-heading">
      <div class="sect-h"><h2 id="related-heading">Related</h2><a href={`/topics/${data.pillar}`}>More on {pillar.short.toLowerCase()} →</a></div>
      <CardGrid posts={related} seriesTotals={seriesTotals} />
    </section>
  )}
</BaseLayout>

<script>
  import "../../scripts/story";
  import "../../scripts/labs";

  // Copy buttons on code blocks (the markup comes from rehypeCodeBlocks).
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".code-block__copy")) {
    btn.addEventListener("click", async () => {
      const pre = btn.closest(".code-block")?.querySelector("pre");
      if (!pre) return;
      const lines = [...pre.querySelectorAll<HTMLElement>(".line")];
      const isDiff = btn.closest<HTMLElement>(".code-block")?.dataset.lang === "diff";
      const code = lines.length
        ? lines.map((l) => (isDiff ? l.textContent!.replace(/^[+-]/, "") : l.textContent)).join("\n")
        : pre.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = "Copied";
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        btn.textContent = "Press Ctrl/⌘ C";
      }
      setTimeout(() => (btn.textContent = "Copy"), 2000);
    });
  }
</script>

<style>
  /* ---------- hero ---------- */
  .p-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: min(calc(100vh - var(--bar-h)), 820px);
    background: var(--c);
    color: var(--on);
    border-bottom: var(--rule-w) solid #1b1814;
  }
  .p-hero :focus-visible { outline-color: var(--on); }
  .p-hero a.chip:hover { background: var(--on); color: var(--c); border-color: var(--on); }
  .p-hero__text {
    container-type: inline-size;
    padding: 36px var(--gutter) 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    min-width: 0;
  }
  .p-hero__text .phead__kicker { margin: 0; }
  :global(.p-hero__title) {
    margin: 0;
    font: 900 clamp(2.25rem, 6.6vw, 7rem) / 0.88 var(--display);
    font-stretch: 112%;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  :global(.p-hero__title--xl) { font-size: clamp(2.75rem, 7.4vw, 7.75rem); font-stretch: 118%; }
  :global(.p-hero__title--md) { font-size: clamp(1.875rem, 3.8vw, 4rem); line-height: 0.92; font-stretch: 105%; }
  /* No word may be wider than the column: --k is the width of one capital
     in em at each size's stretch, --lw the longest word's length. */
  :global(.p-hero__title) { --k: 0.86; font-size: min(clamp(2.25rem, 6.6vw, 7rem), 100cqw / (var(--lw) * var(--k))); }
  :global(.p-hero__title--xl) { --k: 0.9; font-size: min(clamp(2.75rem, 7.4vw, 7.75rem), 100cqw / (var(--lw) * var(--k))); }
  :global(.p-hero__title--md) { --k: 0.82; font-size: min(clamp(1.875rem, 3.8vw, 4rem), 100cqw / (var(--lw) * var(--k))); }
  .p-hero__dek { margin: 0; max-width: 36ch; font-size: 1.375rem; line-height: 1.4; }
  .p-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    padding-top: 14px;
    border-top: 1.5px solid currentColor;
    font: 500 0.75rem / 1.4 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .p-meta b { display: block; font-weight: 700; }
  .p-meta__revised summary { list-style: none; cursor: pointer; text-decoration: underline dotted; text-underline-offset: 0.25em; }
  .p-meta__revised summary::-webkit-details-marker { display: none; }
  .p-meta__revised p {
    margin: 10px 0 0;
    max-width: 52ch;
    padding: 10px 12px;
    background: #1b1814;
    color: #f4f0e7;
    font: 400 0.9375rem / 1.5 var(--serif);
    text-transform: none;
    letter-spacing: 0;
  }
  .p-hero__art { position: relative; background: #1b1814; border-left: var(--rule-w) solid #1b1814; overflow: hidden; }
  .p-hero__art :global(.cover), .p-hero__art :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (max-width: 900px) {
    .p-hero { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .p-hero__art { border-left: 0; border-top: var(--rule-w) solid #1b1814; aspect-ratio: 16 / 10; }
  }

  /* ---------- body ---------- */
  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 42rem) minmax(0, 1fr);
    grid-template-areas: ". toc ." ". body ." ". end .";
    padding: 56px var(--gutter) 64px;
  }
  .article__toc { grid-area: toc; min-width: 0; }
  .post-body { grid-area: body; min-width: 0; }
  .article__end { grid-area: end; min-width: 0; display: grid; gap: 36px; margin-top: 64px; }
  @media (min-width: 1280px) {
    .article { grid-template-areas: "toc body ." "toc end ."; column-gap: 40px; }
    .article__toc { justify-self: end; width: 100%; max-width: 15rem; }
  }
  .article__share { display: grid; gap: 14px; padding-top: 20px; border-top: var(--rule-w) solid var(--line); }
  .article__share p { margin: 0; font: 500 0.8125rem / 1.6 var(--mono); color: var(--muted); }
  .article__share a { color: var(--ink); }
</style>
