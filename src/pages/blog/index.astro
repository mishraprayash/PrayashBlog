---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import CardGrid from "../../components/CardGrid.astro";
import { PILLARS, PILLAR_IDS } from "../../data/taxonomy";
import { getPosts, getSeries } from "../../lib/posts";

const posts = await getPosts();
const series = getSeries(posts);
const seriesTotals = new Map(series.map((s) => [s.id, s.parts.length]));
const years = [...new Set(posts.map((p) => p.data.publishDate.getUTCFullYear()))];
---

<BaseLayout title="Writing" description="Everything I've written on backend engineering: messaging, PostgreSQL, running services, and the network edge.">
  <PageHead
    title="All writing"
    kicker={[
      { label: "Topics" },
      ...PILLAR_IDS.map((id) => ({ href: `/topics/${id}`, label: PILLARS[id].short })),
      { href: "/series", label: `${series.length} series` },
      { href: "/rss.xml", label: "RSS" },
    ]}
  >
    <p class="phead__lede">{posts.length} posts on backend engineering, newest first.</p>
  </PageHead>

  {years.map((year) => (
    <section aria-labelledby={`y-${year}`}>
      <div class="sect-h"><h2 id={`y-${year}`}>{year}</h2><span>{posts.filter((p) => p.data.publishDate.getUTCFullYear() === year).length} posts</span></div>
      <CardGrid posts={posts.filter((p) => p.data.publishDate.getUTCFullYear() === year)} seriesTotals={seriesTotals} />
    </section>
  ))}
</BaseLayout>
