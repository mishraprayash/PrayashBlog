---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSeriesForPost } from "../data/series";

const allPosts = await getCollection("blog", ({ data }) => {
  if (import.meta.env.PROD) return !data.draft;
  return true;
});

const publishedPosts = allPosts.sort((a, b) => {
  const dateA = a.data.updatedDate ? Math.max(a.data.publishDate.getTime(), a.data.updatedDate.getTime()) : a.data.publishDate.getTime();
  const dateB = b.data.updatedDate ? Math.max(b.data.publishDate.getTime(), b.data.updatedDate.getTime()) : b.data.publishDate.getTime();
  return dateB - dateA;
});

const featuredPost = publishedPosts[0];
const featuredSeriesInfo = featuredPost ? getSeriesForPost(featuredPost.id) : undefined;
const remainingPosts = publishedPosts.slice(1);
---

<BaseLayout
  title="Home"
  description="Distributed Systems & AI Engineer specializing in cloud-native microservices, event-driven architectures, and intelligent agents."
>
  <div class="mx-auto max-w-5xl px-6 py-12 sm:py-20 relative z-10">
    <!-- Hero / Profile Section -->
    <section class="mb-20 grid gap-10 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-[#f4eee3] dark:bg-brand-950/40 text-brand-700 dark:text-brand-300 border border-[#e8e2d5] dark:border-brand-500/20">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-600 dark:bg-brand-400 animate-pulse"></span>
          distributed systems &middot; ai engineering
        </div>

        <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-[#1c1915] dark:text-zinc-50 leading-tight">
          Prayash Mishra
        </h1>

        <p class="text-base sm:text-lg text-[#5c5344] dark:text-zinc-400 leading-relaxed max-w-xl">
          Distributed Systems & AI Engineer specializing in cloud-native microservices, event-driven architectures, and intelligent agentic RAG systems. Documenting production mechanics, sidecar patterns, and backend reliability.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-3 text-sm">
          <a
            href="/blog"
            class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-brand-700 text-white font-medium hover:bg-brand-600 transition-all shadow-sm"
          >
            Read Publications &rarr;
          </a>
          <a
            href="https://github.com/mishraprayash"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-4 py-2 rounded-xl border border-[#e8e2d5] dark:border-zinc-800 bg-[#ffffff] dark:bg-zinc-900 font-medium text-[#453e33] dark:text-zinc-300 hover:border-brand-600/40 transition-all shadow-sm shadow-[#ece5d8]/40 dark:shadow-none"
          >
            GitHub Profile
          </a>
          <a
            href="https://www.linkedin.com/in/prayash-mishra-5a409422b/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-4 py-2 rounded-xl border border-[#e8e2d5] dark:border-zinc-800 bg-[#ffffff] dark:bg-zinc-900 font-medium text-[#453e33] dark:text-zinc-300 hover:border-brand-600/40 transition-all shadow-sm shadow-[#ece5d8]/40 dark:shadow-none"
          >
            LinkedIn
          </a>
        </div>
      </div>

      <!-- Developer Terminal -->
      <div class="lg:col-span-5 w-full">
        <div class="code-terminal">
          <div class="pt-3 font-mono space-y-1.5 text-[#5c5344] dark:text-zinc-400 text-xs">
            <p class="text-[#a89d89] dark:text-zinc-600"># Engineering Profile</p>
            <p><span class="text-emerald-600 dark:text-emerald-400">$</span> whoami --details</p>
            <p class="text-[#1c1915] dark:text-zinc-200 font-semibold pl-2">
              role: <span class="text-brand-700 dark:text-brand-300">"Distributed Systems & AI Engineer"</span>
            </p>
            <p class="text-[#5c5344] dark:text-zinc-400 pl-2">
              focus: [<span class="text-amber-700 dark:text-amber-300">"Sidecars (Dapr)"</span>, <span class="text-amber-700 dark:text-amber-300">"Agentic RAG"</span>, <span class="text-amber-700 dark:text-amber-300">"Event-Driven"</span>]
            </p>
            <p class="text-[#5c5344] dark:text-zinc-400 pl-2">
              stack: [<span class="text-brand-700 dark:text-brand-300">"Go"</span>, <span class="text-brand-700 dark:text-brand-300">"Node.js"</span>, <span class="text-brand-700 dark:text-brand-300">"NestJS"</span>, <span class="text-brand-700 dark:text-brand-300">"PostgreSQL"</span>, <span class="text-brand-700 dark:text-brand-300">"Docker"</span>]
            </p>
            <p class="pt-1"><span class="text-emerald-600 dark:text-emerald-400">$</span> cat mission.txt</p>
            <p class="text-zinc-700 dark:text-zinc-300 pl-2 italic">
              "Bridging advanced AI logic with enterprise-grade backend stability."
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Spotlight Post -->
    {
      featuredPost && (
        <section class="mb-16">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[#7d7260] dark:text-zinc-500 flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-600 dark:bg-brand-400"></span>
              Featured Deep Dive
            </h2>
          </div>

          <a
            href={`/blog/${featuredPost.id}`}
            class="group block p-6 sm:p-8 rounded-2xl border border-[#e8e2d5] dark:border-zinc-800 bg-[#ffffff] dark:bg-zinc-900/40 backdrop-blur-sm shadow-sm shadow-[#ece5d8]/40 hover:shadow-md hover:border-brand-600/40 transition-all duration-200"
          >
            <div class="flex flex-wrap items-center gap-2 mb-3 text-xs text-[#7d7260] dark:text-zinc-500">
              {featuredPost.data.category && (
                <span class="font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-md bg-[#f4eee3] dark:bg-brand-950/40 text-brand-700 dark:text-brand-300 font-mono border border-[#e8e2d5] dark:border-brand-500/20">
                  {featuredPost.data.category}
                </span>
              )}
              {featuredPost.data.category && <span>&middot;</span>}
              <time datetime={featuredPost.data.publishDate.toISOString()}>
                {featuredPost.data.publishDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
              {featuredPost.data.updatedDate && (
                <span class="inline-flex items-center gap-1 text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 font-semibold border border-emerald-200 dark:border-emerald-800/50" title={`Revised on ${featuredPost.data.updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}`}>
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  Updated {featuredPost.data.updatedDate.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                </span>
              )}
              {featuredSeriesInfo && (
                <span class="inline-flex items-center gap-1 text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-brand-50 dark:bg-brand-950/40 text-brand-800 dark:text-brand-300 font-semibold border border-brand-200 dark:border-brand-500/20">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                    <path d="M6 6h10"></path>
                    <path d="M6 10h10"></path>
                  </svg>
                  {featuredSeriesInfo.series.shortTitle} &middot; Part {featuredSeriesInfo.part} of {featuredSeriesInfo.total}
                </span>
              )}
            </div>

            <h3 class="text-2xl sm:text-3xl font-black text-[#1c1915] dark:text-zinc-50 group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors mb-3 leading-tight">
              {featuredPost.data.title}
            </h3>

            <p class="text-sm sm:text-base text-[#5c5344] dark:text-zinc-400 leading-relaxed mb-5 line-clamp-3">
              {featuredPost.data.description}
            </p>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-3 border-t border-[#f4eee3] dark:border-zinc-800/80">
              <div class="flex flex-wrap gap-1.5">
                {featuredPost.data.tags.slice(0, 4).map((tag) => (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#f4eee3] dark:bg-zinc-800 text-[#5c5344] dark:text-zinc-400 border border-[#e8e2d5]/60 dark:border-transparent">
                    #{tag}
                  </span>
                ))}
              </div>
              <span class="text-xs font-semibold text-brand-700 dark:text-brand-300 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                Read deep dive &rarr;
              </span>
            </div>
          </a>
        </section>
      )
    }

    <!-- Recent Publications Grid -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-xl font-bold tracking-tight text-[#1c1915] dark:text-zinc-50">
          All Publications
        </h2>
        <a
          href="/blog"
          class="text-xs font-semibold text-brand-700 dark:text-brand-300 hover:underline flex items-center gap-1"
        >
          View directory &rarr;
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {
          remainingPosts.map((post) => {
            const seriesInfo = getSeriesForPost(post.id);
            return (
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col p-5 sm:p-6 rounded-2xl border border-[#e8e2d5] dark:border-zinc-800/80 bg-[#ffffff] dark:bg-zinc-900/30 backdrop-blur-sm shadow-sm shadow-[#ece5d8]/30 hover:border-brand-600/40 hover:-translate-y-0.5 transition-all duration-200"
              >
                <div class="flex items-center gap-2 text-xs text-[#7d7260] dark:text-zinc-500 mb-2.5 flex-wrap">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                  {post.data.updatedDate && (
                    <span class="inline-flex items-center gap-1 text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 font-semibold border border-emerald-200 dark:border-emerald-800/50" title={`Revised on ${post.data.updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}`}>
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      Updated {post.data.updatedDate.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                    </span>
                  )}
                  {seriesInfo && (
                    <span class="inline-flex items-center gap-1 text-[10px] font-mono px-2 py-0.5 rounded-full bg-brand-50 dark:bg-brand-950/40 text-brand-800 dark:text-brand-300 font-semibold border border-brand-200 dark:border-brand-500/20">
                      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                        <path d="M6 6h10"></path>
                        <path d="M6 10h10"></path>
                      </svg>
                      {seriesInfo.series.shortTitle} &middot; Part {seriesInfo.part} of {seriesInfo.total}
                    </span>
                  )}
                  {post.data.category && (
                    <>
                      <span>&middot;</span>
                      <span class="uppercase tracking-wider text-[10px] font-mono font-semibold text-brand-700 dark:text-brand-300">
                        {post.data.category}
                      </span>
                    </>
                  )}
                </div>

              <h3 class="text-lg font-bold text-[#1c1915] dark:text-zinc-100 group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors mb-2 leading-snug line-clamp-2">
                {post.data.title}
              </h3>

              <p class="text-xs sm:text-sm text-[#5c5344] dark:text-zinc-400 line-clamp-2 leading-relaxed mb-4 flex-grow">
                {post.data.description}
              </p>

              <div class="flex flex-wrap gap-1.5 mt-auto pt-2 border-t border-[#f4eee3] dark:border-zinc-800/60">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#f4eee3] dark:bg-zinc-800/60 text-[#5c5344] dark:text-zinc-400 border border-[#e8e2d5]/60 dark:border-transparent">
                    #{tag}
                  </span>
                ))}
              </div>
            </a>
          );
        })
      }
      </div>
    </section>
  </div>
</BaseLayout>