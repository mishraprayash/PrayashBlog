---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { PILLARS, PILLAR_IDS } from "../data/taxonomy";
import { SITE } from "../lib/seo";
import { getPosts, getSeries, postsByPillar } from "../lib/posts";

const posts = await getPosts();
const seriesTotals = new Map(getSeries(posts).map((s) => [s.id, s.parts.length]));
const startHere = posts
  .filter((p) => p.data.startHere)
  .sort((a, b) => a.data.startHere! - b.data.startHere!);
const recent = posts.slice(0, 5);

// One line on why each "Start here" post is worth reading. Edit freely;
// these are meant to sound like you recommending your own work.
const startNotes: Record<string, string> = {
  "transactional-outbox-pattern-production-realities":
    "Why the obvious polling relay loses events, and what Postgres does to you once you fix that.",
  "idempotency-in-distributed-systems":
    "Why a Redis lock isn't idempotency, and how to make retries safe inside one Postgres transaction.",
  "nginx-lua-ai-waf-traps-bypasses":
    "The ways an ML filter on the request path fails open or gets bypassed, and what holds up.",
};
---

<BaseLayout title={SITE.name} titleOverride={`${SITE.name}: ${SITE.tagline}`} description={SITE.description}>
  <div class="page">
    <div class="page__col">
      <section>
        <h1 class="page-title">Prayash Mishra</h1>
        <p class="page-lede">
          I'm a backend engineer. I write about how distributed systems fail where they meet databases,
          message brokers, sidecars and the network, and what it takes to make them hold. Most of these posts
          come out of problems I worked through on a recent project.
        </p>
        <ul class="page-links">
          <li><a href="/blog">All writing</a></li>
          <li><a href="https://github.com/mishraprayash">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/prayash-mishra-5a409422b/">LinkedIn</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </section>

      {startHere.length > 0 && (
        <section aria-labelledby="start-here">
          <h2 class="section-title" id="start-here">Start here</h2>
          <PostList posts={startHere} notes={startNotes} seriesTotals={seriesTotals} />
        </section>
      )}

      <section aria-labelledby="recent">
        <h2 class="section-title" id="recent">Recent</h2>
        <PostList posts={recent} seriesTotals={seriesTotals} />
        <p class="section-more"><a href="/blog">All {posts.length} posts →</a></p>
      </section>

      <section aria-labelledby="topics">
        <h2 class="section-title" id="topics">Topics</h2>
        <ul class="def-list">
          {PILLAR_IDS.map((id) => {
            const count = postsByPillar(posts, id).length;
            return (
              <li>
                <a class="def-list__name" href={`/topics/${id}`}>{PILLARS[id].title}</a>
                <p class="def-list__desc">{PILLARS[id].description}</p>
                <p class="def-list__meta">{count > 0 ? `${count} ${count === 1 ? "post" : "posts"}` : "Posts coming"}</p>
              </li>
            );
          })}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
