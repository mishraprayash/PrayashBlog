---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";

const recent = (await getPosts()).slice(0, 5);
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <PageHead title="404: not found" pillar="messaging">
    <p class="phead__lede">
      If you followed a link to a post, the address may have been mistyped. Everything is listed on the
      <a href="/blog">Writing</a> page.
    </p>
  </PageHead>
  <section aria-labelledby="recent">
    <div class="sect-h"><h2 id="recent">Recent posts</h2></div>
    <PostList posts={recent} />
  </section>
</BaseLayout>
