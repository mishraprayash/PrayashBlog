---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";

const recent = (await getPosts()).slice(0, 5);
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <div class="page">
    <div class="page__col">
      <header>
        <h1 class="page-title">This page doesn't exist.</h1>
        <p class="page-lede">
          If you followed a link to a post, the address may have been mistyped. Everything is listed on the
          <a href="/blog">Writing</a> page.
        </p>
      </header>
      <section aria-labelledby="recent">
        <h2 class="section-title" id="recent">Recent posts</h2>
        <PostList posts={recent} />
      </section>
    </div>
  </div>
</BaseLayout>
