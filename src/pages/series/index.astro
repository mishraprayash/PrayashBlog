---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import { PILLARS } from "../../data/taxonomy";
import { getPosts, getSeries, readingTime } from "../../lib/posts";

const series = getSeries(await getPosts());
---

<BaseLayout title="Series" description="Multi-part posts, meant to be read in order.">
  <PageHead title="Series" kicker={[{ href: "/blog", label: "← Writing" }]}>
    <p class="phead__lede">Multi-part posts, meant to be read in order.</p>
  </PageHead>
  <ol class="rows">
    {series.map((s, i) => (
      <li class:list={[`pillar-${s.parts[0].data.pillar}`]}>
        <a class="row" href={`/series/${s.id}`}>
          <span class="row__n">{String(i + 1).padStart(2, "0")}</span>
          <span><span class="row__t">{s.title}</span><span class="row__d">{s.description}</span></span>
          <span class="row__m">
            <span class="pill">{PILLARS[s.parts[0].data.pillar].short}</span><br />
            {s.parts.length} parts · {s.parts.reduce((n, p) => n + readingTime(p.body), 0)} min
          </span>
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>
