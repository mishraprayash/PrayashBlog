---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import CardGrid from "../../components/CardGrid.astro";
import { getPosts, getSeries, postUrl, readingTime, type SeriesInfo } from "../../lib/posts";

export async function getStaticPaths() {
  return getSeries(await getPosts()).map((series) => ({ params: { id: series.id }, props: { series } }));
}

const { series } = Astro.props as { series: SeriesInfo };
const total = series.parts.reduce((n, p) => n + readingTime(p.body), 0);
const pillar = series.parts[0].data.pillar;
const totals = new Map([[series.id as string, series.parts.length]]);
---

<BaseLayout title={series.title} description={series.description} pillar={pillar}>
  <PageHead title={series.title} pillar={pillar} size="md" kicker={[{ href: "/series", label: "← All series" }]}>
    <p class="phead__lede">{series.description}</p>
    <p class="phead__meta">{series.parts.length} parts · {total} min in total · <a href={postUrl(series.parts[0])}>Start with part 1 →</a></p>
  </PageHead>
  <CardGrid posts={series.parts} seriesTotals={totals} heading="h2" label="Parts, in order" />
</BaseLayout>
